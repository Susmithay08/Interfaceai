# LLM provider selection - discovery only. Replay never reads these.
LLM_PROVIDER=groq
# Groq retires models fairly often. If this one 404s, list what your key can see with:
#   curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# Target application
TARGET_BASE_URL=http://localhost:4000
TARGET_APP_PORT=4000

# Operator console
OPERATOR_CONSOLE_PORT=4100

# Synthetic credentials for the demo app. Never real, never written to artifacts or evidence.
#
# An artifact refers to a credential by ref, never by value. The runtime maps that ref to an
# env var: CRED_ + the ref uppercased, with every non-alphanumeric character replaced by "_".
# So {"from": "credential", "ref": "corebank.teller.username"} reads CRED_COREBANK_TELLER_USERNAME.
# These two are what the sessionExpired recovery re-authenticates with.
CRED_COREBANK_TELLER_USERNAME=demo.teller
CRED_COREBANK_TELLER_PASSWORD=demo-pass-not-real
