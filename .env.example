# LLM provider selection - discovery only. Replay never reads these.
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=

# Target application
TARGET_BASE_URL=http://localhost:4000
TARGET_APP_PORT=4000

# Operator console
OPERATOR_CONSOLE_PORT=4100

# Synthetic credentials for the demo app. Never real, never written to artifacts or evidence.
COREBANK_TELLER_USERNAME=demo.teller
COREBANK_TELLER_PASSWORD=demo-pass-not-real
